# App
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=kilat
DB_PASSWORD=kilat_secret
DB_NAME_BOOKING=kilat_booking
DB_NAME_PAYMENT=kilat_payment
DB_NAME_RUNNER=kilat_runner
DB_NAME_IDENTITY=kilat_identity
DB_NAME_TRACKING=kilat_tracking
DB_NAME_CHAT=service_chat
DB_NAME_INCIDENT=service_incident
DB_NAME_LOYALTY=service_loyalty
DB_NAME_ZONES=service_zones
DB_SSL_MODE=disable

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_PREFIX=kilat

# JWT
JWT_SECRET=super-secret-jwt-key-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Services
SERVICE_BOOKING_PORT=8001
SERVICE_PAYMENT_PORT=8002
SERVICE_RUNNER_PORT=8003
SERVICE_IDENTITY_PORT=8004
SERVICE_TRACKING_PORT=8005
SERVICE_NOTIFICATION_PORT=8006
SERVICE_REVIEW_PORT=8007
SERVICE_CHAT_PORT=8008
SERVICE_INCIDENT_PORT=8009
SERVICE_LOYALTY_PORT=8010
SERVICE_ZONES_PORT=8011

# Payment
PLATFORM_FEE_PERCENT=15

# API Gateway
GATEWAY_PORT=8080
UPSTREAM_IDENTITY=http://localhost:8004
UPSTREAM_RUNNER=http://localhost:8003
UPSTREAM_BOOKING=http://localhost:8001
UPSTREAM_PAYMENT=http://localhost:8002
UPSTREAM_TRACKING=http://localhost:8005
UPSTREAM_NOTIFICATION=http://localhost:8006
UPSTREAM_REVIEW=http://localhost:8007
UPSTREAM_CHAT=http://localhost:8008
UPSTREAM_INCIDENT=http://localhost:8009
UPSTREAM_LOYALTY=http://localhost:8010
UPSTREAM_ZONES=http://localhost:8011
RATE_LIMIT_PER_MIN=200

# Storage
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kilat-runner
MINIO_USE_SSL=false

# External APIs
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
