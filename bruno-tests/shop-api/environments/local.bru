vars {
  baseUrl: http://localhost:8080
  ownerToken: paste-shop-owner-access-token
  staffToken: paste-staff-access-token
  customerToken: paste-customer-access-token
  runnerToken: paste-runner-access-token
  shopId: paste-shop-id
  staffUserId: paste-staff-user-id-or-invite-id
